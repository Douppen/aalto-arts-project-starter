{
  "name": "aalto-arts",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "next build",
    "start": "next start",
    "dev": "next dev",
    "db": "drizzle-kit",
    "db:studio": "drizzle-kit studio",
    "db:studio:prod": "drizzle-kit studio --config drizzle.config.prod.ts",
    "docker:up": "docker compose -f docker-compose.yml up -d && wait-on --timeout 10000 tcp:localhost:5432",
    "docker:down": "docker compose -f docker-compose.yml down --volumes --remove-orphans",
    "lint": "eslint .",
    "typecheck": "tsc --pretty --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.667.0",
    "@aws-sdk/s3-request-presigner": "^3.667.0",
    "@headlessui/react": "^2.1.10",
    "@hookform/resolvers": "^3.9.0",
    "@neondatabase/serverless": "^0.10.1",
    "@next-safe-action/adapter-react-hook-form": "^1.0.13",
    "clsx": "^2.1.1",
    "dotenv": "^16.4.5",
    "drizzle-orm": "^0.34.1",
    "framer-motion": "^11.11.7",
    "next": "14.2.15",
    "next-safe-action": "^7.9.4",
    "postgres": "^3.4.4",
    "react": "^18",
    "react-dom": "^18",
    "react-hook-form": "^7.53.0",
    "server-only": "^0.0.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.48.1",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/react": "^16.0.1",
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "drizzle-kit": "^0.25.0",
    "eslint": "^8",
    "eslint-config-next": "14.2.15",
    "jsdom": "^25.0.1",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.13",
    "typescript": "^5.6.3",
    "vite-tsconfig-paths": "^5.0.1",
    "vitest": "^2.1.3",
    "wait-on": "^8.0.1"
  }
}
